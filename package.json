{
  "name": "lab-10-travel-crud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "dotenvx run -- node server/index.js",
    "dev:all": "dotenvx run -- concurrently \"vite --host 0.0.0.0\" \"node server/index.js\"",
    "test": "dotenvx run -- vitest run",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "db:seed": "dotenvx run -- node scripts/seed-database.js"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.44.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "concurrently": "^8.2.2",
    "jsdom": "^24.1.1",
    "supertest": "^7.0.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
